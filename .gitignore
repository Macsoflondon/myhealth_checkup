# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
# Vendored npm runtime files for edge functions keep the package's own dist/
# layout (see supabase/functions/_vendor/README.md).
!supabase/functions/_vendor/**/dist/
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env.local
.env.*.local

# Build artifacts / CLI temp
*.tsbuildinfo
supabase/.temp/

# Nitro/Wrangler build output and local dev state. Must stay ignored: Tailwind
# v4 auto-detects class names from every non-ignored file, so a build output
# folder left in the tree leaks into the SSR CSS pass and gives the server
# HTML a stylesheet hash the client build never emitted.
.output/
.wrangler/state/
